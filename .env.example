NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Para testar por Bearer manual, sem depender de um servidor OAuth.
AUTH_MODE=personal_token
# Produção OAuth: veja docs/oauth-production.md. O próprio MCP é o emissor.
# OAUTH_ISSUER=https://mcp.allyson.com.br
# SUPABASE_OAUTH_CLIENT_ID=uuid-da-aplicacao-confidencial
# SUPABASE_OAUTH_CLIENT_SECRET=segredo-da-aplicacao-confidencial
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect
OAUTH_ACCESS_TOKEN_SECONDS=900
OAUTH_CONNECTION_SECONDS=2592000
# API de leitura executada com sessão de usuário, preservando RLS.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# 32 bytes aleatórios em hexadecimal; exclusivo do backend.
SESSION_ENCRYPTION_KEY=replace-with-64-hex-characters
MCP_CURSOR_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# Autentica apenas as rotas internas /internal/mcp, nunca as consultas ao Supabase.
SAAS_API_KEY=replace-with-a-dedicated-server-secret-at-least-32-characters
# Alternativa: API separada. Remover as quatro variáveis acima para usar este modo.
# SAAS_API_URL=https://api.example.com/internal/mcp/
REDIS_URL=redis://127.0.0.1:6379
ALLOWED_ORIGINS=http://localhost:3000
# Inclua o hostname público e o usado nos health checks do balanceador.
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# Habilitar somente quando houver um proxy confiável com rede restrita.
TRUST_PROXY_HOPS=0
USER_REQUESTS_PER_MINUTE=120
COMPANY_REQUESTS_PER_MINUTE=3000
IP_REQUESTS_PER_MINUTE=30000
MAX_INFLIGHT_PER_INSTANCE=200
API_TIMEOUT_MS=8000
MAX_API_RESPONSE_BYTES=1048576
# Dias de calendário calculados pelo MCP (independente do TZ do container).
MCP_TIME_ZONE=America/Sao_Paulo
# As duas RPCs pipeline v7 atuais somam +3h internamente. O adaptador compensa.
# Use 0 somente se essa soma for removida de ambas as RPCs.
PIPELINE_RPC_DATE_SHIFT_MINUTES=180
